# GreenMind Gateway configuration — copy to /opt/greenmind/.env.
# This example contains no credentials. Pairing writes the API key to
# /opt/greenmind/data/secrets.json with restricted permissions.

CLOUD_API_URL=https://green-mind.ch/api/v1
FIRMWARE_API_URL=https://green-mind.ch/api/v1
# Local development only: permits HTTP solely for localhost/loopback URLs.
ALLOW_INSECURE_CLOUD_HTTP=false
BACKEND_HOST=green-mind.ch
BACKEND_PORT=443

DB_PATH=/opt/greenmind/data/queue.db
SECRETS_PATH=/opt/greenmind/data/secrets.json
OTA_DB_PATH=/opt/greenmind/data/ota.db
FIRMWARE_DIR=/opt/greenmind/data/firmware
LOG_DIR=/opt/greenmind/data/logs
LOG_LEVEL=INFO

UPLOAD_INTERVAL=10
HEARTBEAT_INTERVAL=60
MAX_QUEUE_SIZE=100000

# Local sensor/API bounds
MAX_REQUEST_BODY_BYTES=262144
MAX_HTTP_CONCURRENCY=128
HTTP_KEEPALIVE_SECONDS=5
MAX_SAMPLES_PER_BATCH=760
ALLOWED_SAMPLE_RATES=[380]
MAX_SENSOR_IP_ENTRIES=1024
SENSOR_VALUE_MIN_MV=-1000
SENSOR_VALUE_MAX_MV=5000

# WAV archival. Limits stop accepting new batches with HTTP 507; completed
# unacknowledged files are never deleted to make space.
WAV_DIR=/opt/greenmind/data/wav
WAV_CHUNK_MINUTES=10
WAV_MAX_OPEN_WRITERS=64
WAV_FLUSH_INTERVAL_SECONDS=5
WAV_MIN_FREE_BYTES=268435456
WAV_MAX_PENDING_FILES=10000
WAV_MAX_PENDING_BYTES=21474836480
WAV_WARN_PENDING_AGE_HOURS=72

# The retained BLE provisioning implementation is experimental and disabled.
ENABLE_BLE_PROVISIONING=false

# Compatibility proxy that bypasses durable WAV/SQLite buffering. Keep off in
# production unless that weaker delivery path is explicitly required.
ENABLE_EXPERIMENTAL_BIOSIGNAL_PROXY=false

OTA_PORT=8080

# Break-glass compatibility only. Production must bundle wheels in signed OTA
# artifacts and leave this false.
GREENMIND_ALLOW_LEGACY_ONLINE_PIP=false
